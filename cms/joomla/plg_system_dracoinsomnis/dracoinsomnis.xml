<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_dracoinsomnis</name>
	<author>Notorius Vision</author>
	<creationDate>2026-11</creationDate>
	<copyright>(C) 2026 Notorius Vision</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorUrl>https://notoriusvision.com</authorUrl>
	<version>0.1.21</version>
	<description>PLG_SYSTEM_DRACOINSOMNIS_XML_DESCRIPTION</description>
	<namespace path="src">Notorius\Plugin\System\DracoInsomnis</namespace>
	<files>
		<folder plugin="dracoinsomnis">services</folder>
		<folder>src</folder>
		<folder>lib</folder>
		<folder>sql</folder>
		<filename>LICENSE.txt</filename>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_dracoinsomnis.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="ar-AA">language/ar-AA/plg_system_dracoinsomnis.ini</language>
		<language tag="ar-AA">language/ar-AA/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="de-DE">language/de-DE/plg_system_dracoinsomnis.ini</language>
		<language tag="de-DE">language/de-DE/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="es-ES">language/es-ES/plg_system_dracoinsomnis.ini</language>
		<language tag="es-ES">language/es-ES/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="fr-FR">language/fr-FR/plg_system_dracoinsomnis.ini</language>
		<language tag="fr-FR">language/fr-FR/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="it-IT">language/it-IT/plg_system_dracoinsomnis.ini</language>
		<language tag="it-IT">language/it-IT/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="ja-JP">language/ja-JP/plg_system_dracoinsomnis.ini</language>
		<language tag="ja-JP">language/ja-JP/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="pt-BR">language/pt-BR/plg_system_dracoinsomnis.ini</language>
		<language tag="pt-BR">language/pt-BR/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_system_dracoinsomnis.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_system_dracoinsomnis.sys.ini</language>
		<language tag="zh-CN">language/zh-CN/plg_system_dracoinsomnis.ini</language>
		<language tag="zh-CN">language/zh-CN/plg_system_dracoinsomnis.sys.ini</language>
	</languages>
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<config>
		<fields name="params" addfieldprefix="Notorius\Plugin\System\DracoInsomnis\Field">
			<fieldset name="basic">
				<field name="intro" type="dracointro" label="" />
				<field
					name="shield"
					type="radio"
					label="PLG_SYSTEM_DRACOINSOMNIS_SHIELD_LABEL"
					description="PLG_SYSTEM_DRACOINSOMNIS_SHIELD_DESC"
					layout="joomla.form.field.radio.switcher"
					default="0"
					filter="integer"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="waf_mode"
					type="list"
					label="PLG_SYSTEM_DRACOINSOMNIS_WAF_LABEL"
					description="PLG_SYSTEM_DRACOINSOMNIS_WAF_DESC"
					default="off"
					filter="word"
				>
					<option value="off">PLG_SYSTEM_DRACOINSOMNIS_MODE_OFF</option>
					<option value="log">PLG_SYSTEM_DRACOINSOMNIS_MODE_LOG</option>
					<option value="block">PLG_SYSTEM_DRACOINSOMNIS_MODE_BLOCK</option>
				</field>
				<field
					name="pace_mode"
					type="list"
					label="PLG_SYSTEM_DRACOINSOMNIS_PACE_LABEL"
					description="PLG_SYSTEM_DRACOINSOMNIS_PACE_DESC"
					default="off"
					filter="word"
				>
					<option value="off">PLG_SYSTEM_DRACOINSOMNIS_MODE_OFF</option>
					<option value="log">PLG_SYSTEM_DRACOINSOMNIS_MODE_LOG</option>
					<option value="block">PLG_SYSTEM_DRACOINSOMNIS_MODE_BLOCK</option>
				</field>
				<field name="anticopy_rate_ip" type="number" label="PLG_SYSTEM_DRACOINSOMNIS_RATE_IP_LABEL" default="120" min="10" filter="integer" />
				<field name="anticopy_rate_net" type="number" label="PLG_SYSTEM_DRACOINSOMNIS_RATE_NET_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_RATE_NET_DESC" default="600" min="10" filter="integer" />
				<field
					name="proxy_header"
					type="list"
					label="PLG_SYSTEM_DRACOINSOMNIS_PROXY_LABEL"
					description="PLG_SYSTEM_DRACOINSOMNIS_PROXY_DESC"
					default=""
					filter="word"
				>
					<option value="">PLG_SYSTEM_DRACOINSOMNIS_PROXY_NONE</option>
					<option value="cf">PLG_SYSTEM_DRACOINSOMNIS_PROXY_CF</option>
					<option value="xff">PLG_SYSTEM_DRACOINSOMNIS_PROXY_XFF</option>
				</field>
				<field name="trusted_proxies" type="textarea" rows="2" label="PLG_SYSTEM_DRACOINSOMNIS_TRUSTED_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_TRUSTED_DESC" filter="string" />
				<field name="hosting_nets" type="textarea" rows="4" label="PLG_SYSTEM_DRACOINSOMNIS_NETS_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_NETS_DESC" filter="string" />
				<field name="geo_note" type="note" label="PLG_SYSTEM_DRACOINSOMNIS_GEO_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_GEO_DESC" />
				<field name="geo_mode" type="list" label="PLG_SYSTEM_DRACOINSOMNIS_GEO_MODE" default="off" filter="word">
					<option value="off">PLG_SYSTEM_DRACOINSOMNIS_MODE_OFF</option>
					<option value="block">PLG_SYSTEM_DRACOINSOMNIS_GEO_REFUSE</option>
					<option value="allow">PLG_SYSTEM_DRACOINSOMNIS_GEO_ONLY</option>
				</field>
				<field name="geo_scope" type="list" label="PLG_SYSTEM_DRACOINSOMNIS_GEO_SCOPE" default="sensitive" filter="word">
					<option value="sensitive">PLG_SYSTEM_DRACOINSOMNIS_GEO_SENSITIVE</option>
					<option value="site">PLG_SYSTEM_DRACOINSOMNIS_GEO_SITE</option>
				</field>
				<field name="geo_action" type="list" label="PLG_SYSTEM_DRACOINSOMNIS_GEO_ACTION" default="log" filter="word">
					<option value="log">PLG_SYSTEM_DRACOINSOMNIS_MODE_LOG</option>
					<option value="block">PLG_SYSTEM_DRACOINSOMNIS_MODE_BLOCK</option>
				</field>
				<field name="geo_countries" type="text" label="PLG_SYSTEM_DRACOINSOMNIS_GEO_COUNTRIES" description="PLG_SYSTEM_DRACOINSOMNIS_GEO_CREDIT" filter="string" />
				<field name="headers" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_DRACOINSOMNIS_HEADERS_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_HEADERS_DESC" default="0" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="hsts" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_DRACOINSOMNIS_HSTS_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_HSTS_DESC" default="0" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="pwd_min" type="number" label="PLG_SYSTEM_DRACOINSOMNIS_PWD_MIN_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_PWD_MIN_DESC" default="0" min="0" max="64" filter="integer" />
				<field name="pwd_breached" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_DRACOINSOMNIS_PWD_BREACHED_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_PWD_BREACHED_DESC" default="0" filter="integer">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="block_note" type="note" label="PLG_SYSTEM_DRACOINSOMNIS_BLOCK_LABEL" description="PLG_SYSTEM_DRACOINSOMNIS_BLOCK_DESC" />
				<field name="block_value" type="text" label="PLG_SYSTEM_DRACOINSOMNIS_BLOCK_VALUE" filter="string" />
				<field name="block_days" type="list" label="PLG_SYSTEM_DRACOINSOMNIS_BLOCK_DAYS" default="30" filter="integer">
					<option value="7">PLG_SYSTEM_DRACOINSOMNIS_DAYS_7</option>
					<option value="15">PLG_SYSTEM_DRACOINSOMNIS_DAYS_15</option>
					<option value="30">PLG_SYSTEM_DRACOINSOMNIS_DAYS_30</option>
					<option value="90">PLG_SYSTEM_DRACOINSOMNIS_DAYS_90</option>
					<option value="0">PLG_SYSTEM_DRACOINSOMNIS_FOREVER</option>
				</field>
				<field name="block_reason" type="text" label="PLG_SYSTEM_DRACOINSOMNIS_BLOCK_REASON" filter="string" />
				<field name="evidence" type="dracoevidence" label="" />
			</fieldset>
		</fields>
	</config>
</extension>
