msgstr "Netwerken van gehuurde servers"

msgid "The registration could not be completed."
msgstr "De registratie kon niet worden afgerond."

msgid "Request blocked"
msgstr "Verzoek geblokkeerd"

msgid "Address unblocked."
msgstr "Adres gedeblokkeerd."

