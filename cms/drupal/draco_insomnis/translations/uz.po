msgstr "Ijaraga olingan serverlar tarmoqlari"

msgid "The registration could not be completed."
msgstr "Roʻyxatdan oʻtishni yakunlab boʻlmadi."

msgid "Request blocked"
msgstr "Soʻrov bloklandi"

msgid "Address unblocked."
msgstr "Manzil blokdan chiqarildi."

msgid "Unblock"
msgstr "Blokdan chiqarish"

msgid "Nothing blocked right now."
msgstr "Hozircha hech narsa bloklanmagan."

msgid "Last suspicious attempts"
msgstr "Soʻnggi shubhali urinishlar"

msgid "Kept for 90 days. Never passwords. The CSV of an address holds everything it did, ready to attach to an abuse report to its network provider."
msgstr "90 kun saqlanadi. Hech qachon passwordlar saqlanmaydi. Manzilning CSV faylida u qilgan hamma narsa bor, tarmoq provayderiga suiisteʻmol haqida xabar berishga ilova qilishga tayyor."

msgid "Nothing yet."
msgstr "Hali hech narsa yoʻq."

msgid "Address or e-mail"
msgstr "Manzil yoki email"

msgid "Reason"
msgstr "Sabab"

msgid "Until (UTC)"
msgstr "Qachongacha (UTC)"

msgid "Date (UTC)"
msgstr "Sana (UTC)"

